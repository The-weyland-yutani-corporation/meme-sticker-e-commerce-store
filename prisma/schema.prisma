generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLMENT_PENDING
  FULFILLED
  CANCELED
  REFUNDED
}

enum CheckoutMode {
  PAYMENT_FREE
  STRIPE
}

model Order {
  id                      String       @id @default(cuid())
  confirmationToken       String       @unique @default(uuid())
  email                   String?
  currency                String       @default("usd")
  amountTotal             Int
  status                  OrderStatus  @default(FULFILLMENT_PENDING)
  checkoutMode            CheckoutMode @default(PAYMENT_FREE)
  synthetic               Boolean      @default(false)
  stripeCheckoutSessionId String?      @unique
  stripePaymentIntentId   String?      @unique
  items                   OrderItem[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  productSlug   String
  productName   String
  unitAmount    Int
  quantity      Int
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}
